{
  "name": "aura-analog",
  "author": "Miguel Angel Baeyens",
  "version": "1.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Aura Analog",
    "uuid": "3136bd30-19cd-416a-9a53-7ccf0945553d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": [
      "configurable",
      "location",
      "health"
    ],
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "THEME",
      "SECONDS",
      "WORDMARK",
      "BOTTOM",
      "UNITS",
      "LOCMODE",
      "LAT",
      "LON",
      "WX_TEMP",
      "WX_CODE",
      "WX_OK"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_AURA_18",
          "file": "fonts/LiberationSans-Bold.ttf",
          "characterRegex": "[-0-9A-Z°, ]"
        },
        {
          "type": "font",
          "name": "FONT_AURA_14",
          "file": "fonts/LiberationSans-Bold.ttf",
          "characterRegex": "[0-9A-Z ]"
        },
        {
          "type": "font",
          "name": "FONT_WI_25",
          "file": "fonts/WeatherIcons-Regular.ttf",
          "characterRegex": "[]"
        }
      ]
    }
  }
}
